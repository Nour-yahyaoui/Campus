# Copy to .env for local development. Never commit real credentials.
#
# A deployment needs DATABASE_URL + GOOGLE_CLIENT_ID + GOOGLE_CLIENT_SECRET, and
# one of SETUP_TOKEN or INITIAL_ADMIN_EMAIL so the first super-admin can exist.
# Everything else has a safe default. See docs/DEPLOY_QUICK.md.
NODE_ENV=development
APP_ENV=local

# PostgreSQL. Neon works in production; scripts/pg-local.sh starts a local one.
DATABASE_URL=postgresql://postgres@127.0.0.1:55432/campussphere
# Separate database used by destructive integration tests (name must end in _test).
TEST_DATABASE_URL=postgresql://postgres@127.0.0.1:55432/campussphere_test
DB_POOL_MAX=5

# IP addresses are HMAC-ed with this key before storage; without it they are
# hashed with a fixed default, which is not a privacy guarantee. Set it in
# production. Rotating it invalidates rate-limit buckets (harmless).
# IP_HASH_SECRET=
# How many proxies in front of the app append to x-forwarded-for. One is right
# for Vercel, Render, or a single nginx.
TRUSTED_PROXY_HOPS=1

# Canonical public URL. Used for OAuth redirects, cookies, sitemap and emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# First-run setup. In production /api/initialize is read-only unless one of
# these is configured, and it only ever *writes* on POST (the page has a button).
#
# SETUP_TOKEN: required on the setup URL (?token=…) or the x-setup-token header.
# SETUP_TOKEN=
#
# INITIAL_ADMIN_EMAIL: zero-touch alternative. The first verified Google
# sign-in with exactly this address becomes the first super-admin, once. This is
# the recommended production setting because no setup URL can create an account.
# INITIAL_ADMIN_EMAIL=

# Google OAuth. Create an OAuth 2.0 Web client and register
# ${NEXT_PUBLIC_SITE_URL}/api/auth/google/callback as an authorised redirect URI.
# Every host you browse must have its own callback registered, because Google
# matches the URI verbatim. Vercel aliases work as-is; add other hosts here:
# AUTH_ALLOWED_ORIGINS=https://campus.example.edu,https://staging.example.edu
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Development sign-in signs in as any existing account without a password, so it
# is off by default. It is refused in production regardless of this flag, and
# only reachable from localhost / a private network address.
ALLOW_DEV_SIGN_IN=false

# console | smtp | resend. Console logs messages and records them in the database.
EMAIL_TRANSPORT=console
EMAIL_FROM=CampusSphere <no-reply@campussphere.local>
SMTP_URL=
RESEND_API_KEY=

# Image storage (avatars, club logos and covers, project and event covers).
# Leave blank to use the local filesystem driver — development only; it is
# refused in production because containers have no durable disk.
# Neon Object Storage is S3-compatible: create a bucket, then a credential pair
# with the storage:read and storage:write scopes (see docs/DEPLOY_STEPS.md §5).
STORAGE_BUCKET=campus
STORAGE_DRIVER=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Required for non-AWS S3 endpoints such as Neon's; leave unset for AWS S3.
# S3_FORCE_PATH_STYLE=true
# Only set when the bucket's access level is public_read.
STORAGE_PUBLIC_BASE_URL=

# Operations
# Server health panel (Admin → Overview). Point API_BASE_URL at the Rust
# service and the dashboard will probe <url>/health/metrics. Leave it blank and
# the panel says the primary is not configured — it never guesses.
# Use the service root, not .../api: health is /health/*, the read API /api/v1/*.
# API_BASE_URL=https://your-service.onrender.com
# When set, both services must use the same value or the probe gets a 401.
# METRICS_TOKEN=
# Only needed where the platform does not report a memory limit; Vercel and
# Docker both do. It is a reference budget for the percentage, not a quota.
# SERVER_MEMORY_LIMIT_MB=1024
METRICS_RETENTION_DAYS=30
JOBS_POLL_INTERVAL_MS=2000
RATE_LIMIT_DISABLED=false
