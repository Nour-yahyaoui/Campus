# Copy to .env for local development. Never commit real credentials.
#
# For a deployment the required set is just: DATABASE_URL,
# GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET. Everything else has a safe default.
# See docs/DEPLOY_QUICK.md.
NODE_ENV=development
APP_ENV=local

# PostgreSQL. Neon works in production; scripts/pg-local.sh starts a local one.
DATABASE_URL=postgresql://postgres@127.0.0.1:55432/campussphere
# Separate database used by destructive integration tests (name must end in _test).
TEST_DATABASE_URL=postgresql://postgres@127.0.0.1:55432/campussphere_test
DB_POOL_MAX=5

# Canonical public URL. Used for OAuth redirects, cookies, sitemap and emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. If set, /api/initialize requires ?token=<this value>. Without it the
# setup URL is writable only while no super-admin exists, then read-only.
# SETUP_TOKEN=

# Google OAuth. Create an OAuth 2.0 Web client and register
# ${NEXT_PUBLIC_SITE_URL}/api/auth/google/callback as an authorised redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The development sign-in form is refused in production regardless of this flag.
ALLOW_DEV_SIGN_IN=true

# console | smtp | resend. Console logs messages and records them in the database.
EMAIL_TRANSPORT=console
EMAIL_FROM=CampusSphere <no-reply@campussphere.local>
SMTP_URL=
RESEND_API_KEY=

# Image storage (avatars, club logos and covers, project and event covers).
# Leave blank to use the local filesystem driver — development only; it is
# refused in production because containers have no durable disk.
# Neon Object Storage is S3-compatible: create a bucket, then a credential pair
# with the storage:read and storage:write scopes (see docs/DEPLOY_STEPS.md §5).
STORAGE_BUCKET=campus
STORAGE_DRIVER=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Required for non-AWS S3 endpoints such as Neon's; leave unset for AWS S3.
# S3_FORCE_PATH_STYLE=true
# Only set when the bucket's access level is public_read.
STORAGE_PUBLIC_BASE_URL=

# Operations
METRICS_RETENTION_DAYS=30
JOBS_POLL_INTERVAL_MS=2000
RATE_LIMIT_DISABLED=false
